# ============================================================
# Archly — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/archly

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Kafka ────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ─── Auth ─────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── AI — Groq (primary cloud, generous free tier) ────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── AI — GitHub Models / OpenAI (gpt-4o-mini free tier) ──────
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=gpt-4o-mini

# ─── AI — OpenRouter (fallback) ───────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free

# ─── AI — NVIDIA NIM (build.nvidia.com / integrate.api.nvidia.com) ─
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_DEEPSEEK_MODEL=deepseek-ai/deepseek-v4-pro

# ─── AI — Ollama (LAN IP — set this first to test locally) ────
# Point at the machine running Ollama, e.g. http://192.168.31.85:11434
OLLAMA_BASE_URL=http://192.168.31.85:11434
OLLAMA_MODEL=archly-architect
OLLAMA_SCHEMA_MODEL=archly-schema

# ─── Payments (optional) ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ─── API Server ───────────────────────────────────────────────
PORT=8080
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# ─── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
