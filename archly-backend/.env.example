# ── Archly Backend — Server Environment Variables ─────────────────────────
# Copy to .env and fill in values before running docker compose
# NEVER commit .env to git
# --------------------------------------------------------------------------

# ─── Server ───────────────────────────────────────────────────
PORT=8080
ENVIRONMENT=production
CORS_ORIGINS=https://your-frontend.vercel.app

# ─── Database (uses shared postgres container on backend network)
DATABASE_URL=postgresql://admin:change_me_secure_password@postgres:5432/archly?sslmode=disable

# ─── Redis (uses shared redis container on backend network)
REDIS_URL=redis://redis:6379

# ─── Kafka
KAFKA_BROKERS=archly-kafka:9092

# ─── JWT
JWT_SECRET=1aef7a8abc013d5824dde7583e1cfb45af4b99eafcd688f92e13c30ac945c58f
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ─── AI — Gemini (primary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── AI — OpenRouter (fallback)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free

# ─── Payments (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
