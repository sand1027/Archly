# ── Archly Backend — Server Environment Variables ─────────────────────────
# Copy to .env and fill in values before running docker compose
# NEVER commit .env to git
# --------------------------------------------------------------------------

# ─── Server ───────────────────────────────────────────────────
PORT=8080
ENVIRONMENT=production
CORS_ORIGINS=https://your-frontend.vercel.app

# ─── Database (uses shared postgres container on backend network)
DATABASE_URL=postgresql://admin:change_me_secure_password@postgres:5432/archly?sslmode=disable

# ─── Redis (uses shared redis container on backend network)
REDIS_URL=redis://redis:6379

# ─── Kafka
KAFKA_BROKERS=archly-kafka:9092

# ─── JWT
JWT_SECRET=1aef7a8abc013d5824dde7583e1cfb45af4b99eafcd688f92e13c30ac945c58f
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ─── AI — Groq (primary cloud)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── AI — GitHub Models / OpenAI
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=gpt-4o-mini

# ─── AI — OpenRouter (fallback)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=arcee-ai/trinity-large-preview:free

# ─── AI — NVIDIA NIM (build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_DEEPSEEK_MODEL=deepseek-ai/deepseek-v4-pro

# ─── AI — Ollama (LAN IP — set this first to test locally)
# Point at the machine running Ollama, e.g. http://192.168.31.85:11434
OLLAMA_BASE_URL=http://192.168.31.85:11434
OLLAMA_MODEL=archly-architect
OLLAMA_SCHEMA_MODEL=archly-schema

# ─── Payments (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
