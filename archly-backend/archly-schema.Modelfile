        text bucket
        int hits
        timestamptz window_start
    }
    EXPORT_JOBS {
        uuid id PK
        uuid org_id FK
        text kind
        text status
        text storage_key
        timestamptz created_at
    }
"""

PARAMETER temperature 0.1
PARAMETER num_predict 8192
PARAMETER top_p 0.9
PARAMETER repeat_penalty 1.1
PARAMETER stop "```"
