EXAMPLE 6 — IoT sensor data pipeline (smart city scale):
erDiagram
    ORGANIZATIONS ||--o{ SITES : operates
    ORGANIZATIONS ||--o{ USERS : employs
    SITES ||--o{ ZONES : contains
    ZONES ||--o{ DEVICES : hosts
    DEVICE_TYPES ||--o{ DEVICES : classifies
    DEVICES ||--o{ DEVICE_CREDENTIALS : authenticates
    DEVICES ||--o{ TELEMETRY_POINTS : emits
    DEVICES ||--o{ DEVICE_COMMANDS : receives
    DEVICES ||--o{ ALERTS : raises
    ALERT_RULES ||--o{ ALERTS : triggers
    ORGANIZATIONS ||--o{ ALERT_RULES : defines
    ALERTS ||--o{ ALERT_NOTIFICATIONS : notifies
    USERS ||--o{ ALERT_NOTIFICATIONS : receives
    DEVICES ||--o{ FIRMWARE_DEPLOYMENTS : updated_by
    FIRMWARE_VERSIONS ||--o{ FIRMWARE_DEPLOYMENTS : rolled_out
    SITES ||--o{ MAINTENANCE_TICKETS : opens
    DEVICES ||--o{ MAINTENANCE_TICKETS : concerns
    TELEMETRY_POINTS ||--o{ ANOMALY_EVENTS : flags
    ORGANIZATIONS {
        uuid id PK
        text name
        text slug UK
        text plan
        timestamptz created_at
        timestamptz updated_at
    }
    USERS {
        uuid id PK
        uuid org_id FK
        text email UK
        text password_hash
        text role
        boolean is_active
        timestamptz created_at
    }
    SITES {
        uuid id PK
        uuid org_id FK
        text name
        text city
        text country
        numeric lat
        numeric lng
        jsonb meta
        timestamptz created_at
    }
    ZONES {
        uuid id PK
        uuid site_id FK
        text name
        text zone_type
        jsonb polygon
        timestamptz created_at
    }
    DEVICE_TYPES {
        uuid id PK
        text name UK
        text protocol
        jsonb capabilities
        timestamptz created_at
    }
    DEVICES {
        uuid id PK
        uuid zone_id FK
        uuid device_type_id FK
        text serial_number UK
        text name
        text status
        text firmware_version
        numeric last_lat
        numeric last_lng
        timestamptz last_seen_at
        timestamptz commissioned_at
        timestamptz created_at
    }
    DEVICE_CREDENTIALS {
        uuid id PK
        uuid device_id FK
        text auth_type
        text credential_hash
        timestamptz rotated_at
        timestamptz created_at
    }
    TELEMETRY_POINTS {
        uuid id PK
        uuid device_id FK
        text metric
        numeric value
        text unit
        jsonb tags
        timestamptz recorded_at
    }
    DEVICE_COMMANDS {
        uuid id PK
        uuid device_id FK
        text command
        jsonb payload
        text status
        timestamptz issued_at
        timestamptz acked_at
    }
    ALERT_RULES {
        uuid id PK
        uuid org_id FK
        text name
        text metric
        text operator
        numeric threshold
        text severity
        boolean is_active
        timestamptz created_at
    }
    ALERTS {
        uuid id PK
        uuid device_id FK
        uuid rule_id FK
        text severity
        text status
        text message
        jsonb context
        timestamptz opened_at
        timestamptz resolved_at
    }
    ALERT_NOTIFICATIONS {
        uuid id PK
        uuid alert_id FK
        uuid user_id FK
        text channel
        text status
        timestamptz sent_at
    }
    FIRMWARE_VERSIONS {
        uuid id PK
        uuid device_type_id FK
        text version UK
        text storage_key
        text checksum
        text release_notes
        timestamptz published_at
    }
    FIRMWARE_DEPLOYMENTS {
        uuid id PK
        uuid device_id FK
        uuid firmware_version_id FK
        text status
        timestamptz started_at
        timestamptz finished_at
    }
    ANOMALY_EVENTS {
        uuid id PK
        uuid telemetry_point_id FK
        uuid device_id FK
        text model
        numeric score
        text label
        timestamptz detected_at
    }
    MAINTENANCE_TICKETS {
        uuid id PK
        uuid site_id FK
        uuid device_id FK
        text status
        text priority
        text summary
        text body
        timestamptz opened_at
        timestamptz closed_at
    }
