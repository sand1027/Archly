        text failure_code
        text failure_message
        boolean paid
        boolean refunded
        timestamptz created_at
    }
    REFUNDS {
        uuid id PK
        uuid charge_id FK
        bigint amount_cents
        text reason
        text status
        timestamptz created_at
    }
    DISPUTES {
        uuid id PK
        uuid charge_id FK
        text status
        text reason
        bigint amount_cents
        text evidence_status
        timestamptz created_at
        timestamptz due_by
    }
    SUBSCRIPTIONS {
        uuid id PK
        uuid customer_id FK
        uuid price_id FK
        text status
        int quantity
        timestamptz current_period_start
        timestamptz current_period_end
        timestamptz cancel_at
        timestamptz created_at
    }
    INVOICES {
        uuid id PK
        uuid customer_id FK
        uuid subscription_id FK
        text number UK
        text status
        bigint amount_due_cents
        bigint amount_paid_cents
        text currency
        timestamptz due_at
        timestamptz paid_at
        timestamptz created_at
    }
    INVOICE_LINE_ITEMS {
        uuid id PK
