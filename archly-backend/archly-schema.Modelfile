    TWEETS ||--o{ TWEET_HASHTAGS : tagged
    HASHTAGS ||--o{ TWEET_HASHTAGS : used_in
    TWEETS ||--o{ TWEET_MENTIONS : mentions
    USERS ||--o{ TWEET_MENTIONS : mentioned
    DIRECT_THREADS ||--o{ THREAD_MEMBERS : has
    USERS ||--o{ THREAD_MEMBERS : joins
    DIRECT_THREADS ||--o{ DIRECT_MESSAGES : contains
    USERS ||--o{ DIRECT_MESSAGES : sends
    MEDIA_ASSETS ||--o{ MEDIA_VARIANTS : has
    LISTS ||--o{ LIST_MEMBERS : includes
