{
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "generate": {
      "dependsOn": ["^build"],
      "outputs": ["generated/**", "src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "clean": {
      "cache": false
    }
  }
}
